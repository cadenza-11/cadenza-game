:root {
}

.fader {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    translate: 100% 0;
}

.fader.slide-in {
    translate: 0% 0;
}

.fader.slide-in.slide-out {
    translate: -100% 0;
}
