<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StartMenu/StartMenuStyles.uss?fileID=7433441132597879392&amp;guid=6e71e48c6e1969b4497d59acc87e0a75&amp;type=3#StartMenuStyles"/>
    <ui:VisualElement name="c_Panel" class="panel_container" style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; -unity-material: url(&quot;project://database/Assets/Art/UI%20Backgrounds/Orange/Orange%20Start%20Screen.shadergraph?fileID=-876546973899608171&amp;guid=ca6e6f18f57902845b0a2745e8fd401f&amp;type=3#Orange Start Screen&quot;); background-color: rgb(255, 120, 0);"/>
        <ui:Label text="" name="TEMP_TITLE" style="background-image: url(&quot;project://database/Assets/Art/BEATDOWN_logo.png?fileID=2800000&amp;guid=1c046ea92837b6841a2996abb9a3a4c9&amp;type=3#BEATDOWN_logo&quot;); position: absolute; top: 0; left: 0; width: 1024px; height: 512px;"/>
        <ui:VisualElement name="c_Selectables" class="button_container">
            <ui:VisualElement name="phase_Join" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; display: flex; align-self: center;">
                <ui:Label text="Press any button to start!" name="txt_JoinMsg1"/>
            </ui:VisualElement>
            <ui:VisualElement name="phase_Select" style="flex-grow: 1; display: none;">
                <ui:Button text="&#10;" name="b_StartGame" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="Start New Game" name="txt_Action" class="button_text"/>
                </ui:Button>
                <ui:Button text="&#10;" name="b_LastRun" enabled="false" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="Continue Last Run" name="txt_Action" class="button_text"/>
                </ui:Button>
                <ui:Button text="&#10;" name="b_Leaderboard" enabled="false" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="View Leaderboard" name="txt_Action" class="button_text"/>
                </ui:Button>
                <ui:Button text="&#10;" name="b_Settings" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="Settings" name="txt_Action" class="button_text"/>
                </ui:Button>
                <ui:Button text="&#10;" name="b_Credits" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="Credits" name="txt_Action" class="button_text"/>
                </ui:Button>
                <ui:Button text="&#10;" name="b_Exit" class="start_menu_button">
                    <ui:VisualElement name="icon_Focused" class="focus_icon"/>
                    <ui:Label text="Exit Game" name="txt_Action" class="button_text"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
