<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="IndividualResults" src="project://database/Assets/UI/ResultsMenu/IndividualResults.uxml?fileID=9197481963319205126&amp;guid=ad36b2b648f03f84f978739140031799&amp;type=3#IndividualResults"/>
    <Style src="project://database/Assets/UI/ResultsMenu/ResultsMenu.uss?fileID=7433441132597879392&amp;guid=2d58f611297d5d249bf908e30b6c0457&amp;type=3#ResultsMenu"/>
    <ui:VisualElement name="c_Panel" style="flex-grow: 1; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgb(255, 165, 0); background-image: url(&quot;project://database/Assets/Art/TEMPORARY_ASSETS/TEMP_BG_fm_orange.jpg?fileID=2800000&amp;guid=572cce9d4fe981c4894d4a783eda8c57&amp;type=3#TEMP_BG_fm_orange&quot;); -unity-background-image-tint-color: rgba(250, 107, 101, 0.26); border-top-left-radius: 70px; border-top-right-radius: 70px; border-bottom-right-radius: 70px; border-bottom-left-radius: 70px; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; display: none;">
        <ui:VisualElement name="c_Title" style="align-items: center; font-size: 65px; flex-direction: row; justify-content: center; margin-bottom: 15px; margin-top: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(0, 0, 0); width: 100%;">
            <ui:Label text="BAND NAME" name="update_PlayerBand" class="band_name"/>
            <ui:Label text="vs." name="txt_vs" style="margin-right: 5px; margin-left: 5px;"/>
            <ui:Label text="OPPONENT NAME" name="update_LevelName" class="band_name"/>
            <ui:Label text=":" name="txt_colon"/>
            <ui:Label text="YOU WIN!" name="update_WinLoss" style="width: 20%; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="c_Scores" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="c_IndividualStats" style="flex-grow: 1; width: 66%;">
                <ui:VisualElement name="c_TopHalf" style="flex-grow: 1; flex-direction: row;">
                    <ui:Instance template="IndividualResults" name="c_Player" style="width: 50%;"/>
                    <ui:Instance template="IndividualResults" name="c_Player" style="width: 50%;"/>
                </ui:VisualElement>
                <ui:VisualElement name="c_BottomHalf" style="flex-grow: 1; flex-direction: row;">
                    <ui:Instance template="IndividualResults" name="c_Player" style="width: 50%;"/>
                    <ui:Instance template="IndividualResults" name="c_Player" style="width: 50%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="c_TeamStats" class="score_container" style="flex-grow: 1; width: 33%; align-items: center;">
                <ui:Label text="Band Name" name="update_PlayerBandBanner" class="team_name"/>
                <ui:VisualElement name="spacer" class="score_spacer" style="flex-grow: 1; width: 100%;"/>
                <ui:VisualElement name="c_Scores" class="team_stats">
                    <ui:VisualElement name="c_LetterGrade">
                        <ui:Label text="S" name="update_LetterGrade" class="team_stat"/>
                        <ui:Label text="Grade" name="txt_LetterGrade"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="c_OverallAccuracy">
                        <ui:Label text="1000000" name="update_OverallAccuracy" class="team_stat"/>
                        <ui:Label text="Team Score" name="txt_OverallTeamScore" style="align-self: center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="c_MVP" style="flex-grow: 1; height: 30%; width: 50%;">
                    <ui:VisualElement name="portrait_MVP" class="team_MVP_icon">
                        <ui:Label text="MVP" name="txt_MVP" class="team_MVP_text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="c_JudgeScores" class="team_scorecards">
                    <ui:Label text="10" name="update_ScoreCard" class="judge_card"/>
                    <ui:Label text="10" name="update_ScoreCard" class="judge_card"/>
                    <ui:Label text="10" name="update_ScoreCard" class="judge_card"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="c_ActionButtons" style="flex-grow: 1; align-self: center; justify-content: center; display: flex; width: 100%; background-color: rgba(0, 0, 0, 0.67);">
        <ui:Button text="Next level" name="b_Next" class="action_button"/>
        <ui:Button text="Retry level" name="b_Retry" class="action_button"/>
        <ui:Button text="Return to main menu" name="b_MainMenu" class="action_button"/>
    </ui:VisualElement>
</ui:UXML>
