<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD/PlayerHealth.uss?fileID=7433441132597879392&amp;guid=a544beee23391654ca8484f1aba7da89&amp;type=3#PlayerHealth"/>
    <ui:VisualElement name="c_BackLayer" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Art/UI%20Backgrounds/Healthbar/HealthbarBackBlank.png?fileID=2800000&amp;guid=cfa7e35f0bf60d74f9aeb720a15ce526&amp;type=3#HealthbarBackBlank&quot;); background-size: 140% 110%; -unity-background-image-tint-color: rgb(0, 0, 0);"/>
    <ui:VisualElement name="c_Player" class="player_container">
        <ui:VisualElement name="portrait_Character" style="flex-grow: 1; height: 100px; width: 100px; max-width: 100px; max-height: 100px; min-width: 100px; min-height: 100px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); margin-top: 10px; rotate: -2deg; -unity-material: url(&quot;project://database/Assets/Art/UI%20Backgrounds/RGB%20Character%20Portrait.shadergraph?fileID=-876546973899608171&amp;guid=cb8c372293beaba43b8db722f3122359&amp;type=3#RGB Character Portrait&quot;) prop(&quot;_PrimaryColor&quot; rgb(139, 69, 19)) prop(&quot;_SecondaryColor&quot; rgb(255, 0, 0)) prop(&quot;_TertiaryColor&quot; rgb(255, 215, 0)) prop(&quot;_Portrait&quot; url(&quot;project://database/Assets/Art/Characters/Guitarist/Guitarist_Full.png?fileID=2800000&amp;guid=f02b923a0d72c3a47b7fc72748806941&amp;type=3#Guitarist_Full&quot;)); background-image: url(&quot;project://database/Assets/Art/Characters/Crowd/generic_crowd_sprites.png?fileID=2800000&amp;guid=73dae73422dbc8d4d95eca4fd039c565&amp;type=3#generic_crowd_sprites&quot;);"/>
        <ui:VisualElement name="c_Info" style="flex-grow: 1;">
            <ui:Label text="Character Name" name="update_CharacterName" style="font-size: 30px; -unity-font-style: bold; -unity-text-outline-color: rgb(26, 26, 26); -unity-text-outline-width: 3px; color: rgb(255, 255, 255); margin-left: 10px; rotate: -2deg;"/>
            <ui:VisualElement name="c_Bars" style="flex-grow: 1; padding-top: 5px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; justify-content: center;">
                <ui:VisualElement name="c_HealthBar" class="player_meter health">
                    <ui:VisualElement name="icon" class="meter_icon"/>
                    <ui:ProgressBar value="22" name="bar" class="meter" style="width: 75%;"/>
                </ui:VisualElement>
                <ui:VisualElement name="c_FlowBar" class="player_meter flowstate">
                    <ui:VisualElement name="icon" class="meter_icon"/>
                    <ui:ProgressBar value="22" name="bar" class="meter" style="width: 75%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="c_Accuracy" class="accuracy_markers"/>
        <ui:Label text="DOWNED!" name="txt_Faint" class="faint_text"/>
    </ui:VisualElement>
</ui:UXML>
