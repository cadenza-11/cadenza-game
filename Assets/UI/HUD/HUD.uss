:root {
}

.player_health {
    width: 24%;
    margin-right: 22px;
}

.team-streak {
    -unity-font-style: bold;
    font-size: 50px;
    align-self: flex-end;
    width: 150px;
    height: 80px;
    -unity-text-align: middle-right;
    margin-left: 4px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
}

.team-meter {
    flex-grow: 1;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    word-spacing: 35px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.team-meter > .unity-progress-bar__container {
    height: 50px;
    min-height: auto;
    max-height: none;
}

.team-meter .unity-progress-bar__background {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.team-meter .unity-progress-bar__progress {
    -unity-material: url("project://database/Assets/Art/UI%20Backgrounds/Healthbar/ColoredMeters.shadergraph?fileID=-876546973899608171&guid=a8f74c7a88d76e34baa79a83ac73db9b&type=3#ColoredMeters") prop("_Progress" 0.5);
}
